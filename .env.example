# ==========================================
# KONFIGURACJA SYSTEMU OFERTOWANIA
# ==========================================

# === FLASK ===
# WAŻNE: Wygeneruj losowy SECRET_KEY!
# Użyj: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Środowisko
FLASK_ENV=production
DEBUG=False

# === SERWER ===
HOST=0.0.0.0
PORT=40207

# === WYDAJNOŚĆ ===
# Maksymalna liczba równoległych konwersji produktów
MAX_WORKERS=3

# Czas cache w sekundach (1 godzina = 3600)
CACHE_TIMEOUT=3600

# === KONWERSJA DOCX → JPG ===
# DPI dla renderowania (zalecane: 150-200)
# Wyższa wartość = lepsza jakość, ale wolniejsze i większe pliki
DPI=200

# Jakość JPEG (0-100, zalecane: 85-95)
JPEG_QUALITY=90

# === UNOSERVER ===
# Adres serwera unoserver (LibreOffice)
UNOSERVER_HOST=127.0.0.1
UNOSERVER_PORT=2003

# === BEZPIECZEŃSTWO ===
# Lista dozwolonych hostów (oddzielone przecinkami)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS origins (oddzielone przecinkami)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# === OPCJONALNE: REDIS CACHE ===
# Jeśli używasz Redis do cache (zamiast in-memory)
# REDIS_URL=redis://localhost:6379/0

# === OPCJONALNE: MONITORING (SENTRY) ===
# Jeśli używasz Sentry do monitorowania błędów
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# === OPCJONALNE: EMAIL ===
# Jeśli chcesz wysyłać oferty emailem
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# === OPCJONALNE: CLEANUP ===
# Automatyczne usuwanie starych plików (w dniach)
# CLEANUP_DAYS=7

# === OPCJONALNE: RATE LIMITING ===
# Limit requestów na minutę/godzinę
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_HOUR=100
